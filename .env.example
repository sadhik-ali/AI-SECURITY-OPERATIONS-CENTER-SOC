# ---------------------------------------------------------------------------
# AI SOC environment template.  Copy to `.env` in this directory and edit.
# Placeholders only - never commit a file containing real secrets.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Git Bash:            cp .env.example .env
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
SECRET_KEY=replace-with-64-random-hex-chars
# openssl rand -hex 32
ENVIRONMENT=dev
# demo      = synthetic generator, no external infrastructure required
# integrated= ingest from Wazuh and search through OpenSearch
MODE=demo

# --- Database ---------------------------------------------------------------
# Local development without Docker (SQLite needs no server):
DATABASE_URL=sqlite:///./ai_soc.db
# Docker Compose / production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://aisoc:ChangeMeStrong%231@postgres:5432/ai_soc
DB_ECHO=false

POSTGRES_USER=aisoc
POSTGRES_PASSWORD=ChangeMeStrong%231
POSTGRES_DB=ai_soc

# --- Web application --------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_REQUEST_BYTES=1048576
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
INGESTION_RATE_LIMIT_PER_MINUTE=600

# --- Seeded demo identities (created on first start) ------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@aisoc.dev
BOOTSTRAP_ADMIN_PASSWORD=SocDemo!23
DEMO_SEED_ON_STARTUP=true

# --- AI assistant (Ollama, local) -------------------------------------------
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_HOST=0.0.0.0:11434

# --- OpenSearch (integrated mode) -------------------------------------------
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=ChangeMeStrong%231
OPENSEARCH_INDEX=ai-soc-events-*
# Must stay `true` when ENVIRONMENT=prod; the API refuses to start otherwise.
OPENSEARCH_VERIFY_TLS=false
OPENSEARCH_TIMEOUT_SECONDS=10
DISABLE_SECURITY_PLUGIN=false
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# --- Wazuh (integrated mode) -------------------------------------------------
WAZUH_ENABLED=false
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USER=
WAZUH_API_PASSWORD=
# Shared secret the Wazuh integration must present in X-AI-SOC-Ingest-Token.
WAZUH_INGEST_TOKEN=generate-a-long-random-string

# --- Frontend build-time ----------------------------------------------------
VITE_DATA_SOURCE=mock
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws/alerts
VITE_POLL_INTERVAL_MS=15000
