# Data source for the UI. "mock" reads the bundled sample-data store (Phase 1 default),
# "api" calls the FastAPI backend.
VITE_DATA_SOURCE=mock

# Base URL of the backend when VITE_DATA_SOURCE=api
VITE_API_BASE_URL=/api

# WebSocket endpoint for the live alert feed. If unreachable the client falls back to polling.
VITE_WS_URL=/ws/alerts

# Polling interval (ms) used by the live feed fallback and dashboard auto-refresh.
VITE_POLL_INTERVAL_MS=15000
