fetch-retries=5
fetch-retry-mintimeout=5000
fetch-retry-maxtimeout=60000
fund=false
audit=false

# NOTE: this machine runs Avast HTTPS inspection, which re-signs TLS and makes Node's
# bundled CA store reject the registry (UNABLE_TO_VERIFY_LEAF_SIGNATURE).
# Do NOT disable verification. Export the Avast root once and trust it additionally:
#   openssl x509 -inform der -in avast-root.cer -outform pem -out avast-root.pem
#   NODE_EXTRA_CA_CERTS=/path/avast-root.pem npm install
